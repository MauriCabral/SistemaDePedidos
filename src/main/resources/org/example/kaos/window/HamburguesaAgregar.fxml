<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="272.0" prefWidth="341.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.kaos.controller.HamburguesaController">
    <Label layoutX="14.0" layoutY="52.0" text="Nombre" />
    <TextField fx:id="nombreHamburguesa" layoutX="111.0" layoutY="48.0" promptText="Nombre de la hamburguesa" />
    <Label layoutX="14.0" layoutY="85.0" text="Precio SIMPLE" />
    <TextField fx:id="precioSimple" layoutX="111.0" layoutY="80.0" prefHeight="26.0" prefWidth="58.0" promptText="Precio" />
    <Label layoutX="14.0" layoutY="117.0" text="Precio DOBLE" />
    <TextField fx:id="precioDoble" layoutX="111.0" layoutY="112.0" prefHeight="26.0" prefWidth="58.0" promptText="Precio" />
    <Label layoutX="15.0" layoutY="149.0" text="Precio TRIPLE" />
    <TextField fx:id="precioTriple" layoutX="111.0" layoutY="144.0" prefHeight="26.0" prefWidth="58.0" promptText="Precio" />

    <Button layoutX="16.0" layoutY="191.0" onAction="#loadImage" text="Cargar imagen" />
    <ImageView fx:id="imageView" layoutX="150.0" layoutY="60.0" />

    <Button layoutX="109.0" layoutY="234.0" onAction="#handleAccept" text="Aceptar" />
    <Button layoutX="175.0" layoutY="234.0" onAction="#handleAccept" text="Cancelar" />
</AnchorPane>
