<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.image.Image?>
<AnchorPane prefHeight="272.0" prefWidth="341.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.kaos.controller.HamburguesaController" stylesheets="@../style/Style.css">
    <TextField fx:id="nombreHamburguesa" layoutX="110.0" layoutY="18.0" prefHeight="26.0" prefWidth="165.0" promptText="Nombre de la hamburguesa" />
    <Button fx:id="cargarImagen" layoutX="16.0" layoutY="185.0" onAction="#loadImage" text="Cargar imagen" />
    <ImageView fx:id="imageView" layoutX="150.0" layoutY="60.0" />
    <Button layoutX="107.0" layoutY="225.0" onAction="#handleAccept" styleClass="button-transparent">
        <graphic>
            <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../image/Recurso 17.png" />
            </ImageView>
        </graphic>
    </Button>
    <Button layoutX="178.0" layoutY="225.0" onAction="#handleCancelar" styleClass="button-transparent">
        <graphic>
            <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../image/Recurso 16.png" />
            </ImageView>
        </graphic>
    </Button>
    <TextField fx:id="precioSimple" layoutX="111.0" layoutY="57.0" prefHeight="26.0" prefWidth="71.0" promptText="Precio" />
    <Label layoutX="14.0" layoutY="22.0" text="Nombre" />
    <Label layoutX="14.0" layoutY="62.0" text="Precio SIMPLE" />
    <TextField fx:id="precioDoble" layoutX="111.0" layoutY="94.0" prefHeight="26.0" prefWidth="71.0" promptText="Precio" />
    <Label layoutX="14.0" layoutY="99.0" text="Precio DOBLE" />
    <TextField fx:id="precioTriple" layoutX="112.0" layoutY="131.0" prefHeight="26.0" prefWidth="71.0" promptText="Precio" />
    <Label layoutX="15.0" layoutY="136.0" text="Precio TRIPLE" />
</AnchorPane>
